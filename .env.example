# ---------------------------------------------------------------
# Public site configuration
# ---------------------------------------------------------------
# Canonical production origin (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.assistora.com
# Public business inquiry address shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional consultation booking link (Calendly, Cal.com, etc.).
NEXT_PUBLIC_BOOKING_URL=
# Optional social profiles. Leave empty to hide.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=
# Optional Google Tag Manager container (e.g. GTM-XXXXXXX). Loaded only after visitor consent.
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------
# Contact form delivery (server-only — never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------
# Resend API key (https://resend.com). Required for email delivery.
RESEND_API_KEY=
# Verified sender, e.g. "Assistora Website <website@assistora.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives inquiries.
CONTACT_TO_EMAIL=
# Optional CRM / automation webhook (HubSpot workflow, Zapier, Make, n8n...). Receives JSON.
CRM_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header to the CRM webhook.
CRM_WEBHOOK_SECRET=
